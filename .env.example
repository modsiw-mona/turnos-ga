# Copie este archivo a .env y reemplace el valor. El archivo .env NO se
# versiona (está en .gitignore) ni entra a la imagen (.dockerignore).
#
# Clave que deben enviar los clientes en el encabezado X-API-Key para
# usar POST /horario. Para generar una clave aleatoria:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(16))"
API_KEY=cambie-esta-clave
